{
  // 心飞IM 文档 lint 配置
  // 说明：以下条目是「项目文风优先于默认规则」的显式声明，
  // 针对的是本文档体系既有且刻意的写法，不是放宽质量要求。
  "config": {
    "default": true,
    // 本文档体系以长表格与长句承载密集信息，行宽不构成可读性问题。
    "MD013": false,
    // 文档中大量使用 <br> 做表格内换行、<kbd> 标注快捷键。
    "MD033": false,
    // 部分索引 / 说明性文件以一句话开头而非 H1（如 screenshots/README.md）。
    "MD041": false,
    // 加粗引导词充当小节标签是本体系固定文风（如「**页面布局**」「**验收标准**」「**最低要求**」），
    // 另有「*最后更新：YYYY-MM-DD*」这类斜体元信息行，都不应被改写成标题。
    "MD036": false,
    // 有序列表编号在本文档体系中跨小节连续（如 P0 1-3 / P1 4-5 / P2 6-7、研发红线 1-28），
    // 编号承载优先级与条目序号语义，不允许每个列表重置回 1。
    "MD029": false,
    // 多个模块 / 审查报告使用平行的同级标题（如「### 1. 需求清单」），
    // 只要不是同一父节点下的兄弟重复即视为合法。
    "MD024": { "siblings_only": true }
  },
  "ignores": [
    "node_modules/**",
    "dist/**"
  ]
}
